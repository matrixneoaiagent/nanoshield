rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Hybrid Scribe notes
    match /users/{uid}/notes/{noteId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['title', 'text', 'summary', 'question', 'answer', 'source', 'latencyMs', 'chunks', 'createdAt', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200000;
    }

    // NanoShield audit records (Zero PII stored)
    match /users/{uid}/redactions/{redactionId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['title', 'auditHash', 'charCount', 'entityCount', 'entitiesByType', 'source', 'latencyMs', 'modelName', 'maskStyle', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.auditHash is string
        && request.resource.data.auditHash.size() <= 128;
    }
  }
}
